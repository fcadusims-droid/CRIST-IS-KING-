{
  "manifest_version": 3,
  "name": "Redemptio — Filtro de Conteúdo",
  "version": "0.1.0",
  "description": "Substitui conteúdo explícito por imagens e mensagens de fé.",
  "permissions": [
    "storage",
    "offscreen",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["data/wordlist.js", "data/verses.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Redemptio"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "assets/jesus/*",
        "models/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
